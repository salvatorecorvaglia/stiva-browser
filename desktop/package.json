{
  "name": "stiva-browser-desktop",
  "productName": "Stiva Browser",
  "version": "1.2.0",
  "description": "Desktop client for AWS S3, MinIO and S3-compatible storage",
  "homepage": "https://github.com/salvatorecorvaglia/stiva-browser",
  "author": "Salvatore Corvaglia",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.salvatorecorvaglia.stiva-browser",
    "productName": "Stiva Browser",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.mjs",
      "policy.mjs",
      "runtime/**/*",
      "package.json",
      "assets/icon.png",
      "updater.cjs",
      "mac-self-update.cjs",
      "update-ui.mjs"
    ],
    "artifactName": "stiva-browser_${version}_${os}_${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "notarize": false,
      "hardenedRuntime": true,
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Salvatore Corvaglia",
      "icon": "assets/icon.png",
      "executableName": "stiva-browser"
    },
    "publish": {
      "provider": "github",
      "owner": "salvatorecorvaglia",
      "repo": "stiva-browser",
      "releaseType": "release"
    },
    "generateUpdatesFilesForAllChannels": true
  },
  "packageManager": "pnpm@12.16.1"
}
